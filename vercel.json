{
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/lossboss-events",
      "destination": "https://lossboss.app/api/events"
    },
    {
      "source": "/api/lossboss-assn",
      "destination": "https://lossboss.app/api/app-store-notifications"
    },
    {
      "source": "/aitravelagent/:path*",
      "destination": "https://aitravelagent-blue.vercel.app/:path*"
    },
    {
      "source": "/ghosted/c/:key",
      "destination": "/api/ghosted/challenge?key=:key"
    },
    {
      "source": "/ghosted/g/:key",
      "destination": "/api/ghosted/crewinvite?key=:key"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/lossboss",
      "destination": "https://lossboss.app/",
      "permanent": true
    },
    {
      "source": "/lossboss-privacy",
      "destination": "https://lossboss.app/privacy",
      "permanent": true
    },
    {
      "source": "/lossboss-terms",
      "destination": "https://lossboss.app/terms",
      "permanent": true
    }
  ]
}
